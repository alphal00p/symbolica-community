    <mo>[</mo>\n            <mrow>\n              <msubsup>\n                <mrow>\n                  <mi>\ud835\udefe</mi>\n                  <mphantom></mphantom>\n                </mrow>\n                <mrow>\n                  <mphantom>\n                    <mtext>i0</mtext>\n                  </mphantom>\n                </mrow>\n                <mtext>i0</mtext>\n              </msubsup>\n              <mspace width=\"0.12em\"/>\n              <mi>\ud835\udc5b</mi>\n              <mspace width=\"0.12em\"/>\n              <mtext>nb</mtext>\n            </mrow>\n            <mo>]</mo>\n          </mrow>\n          <mphantom></mphantom>\n        </mrow>\n        <mrow>\n          <mtext>i1</mtext>\n          <mspace width=\"0.08em\"/>\n          <mtext>i2</mtext>\n        </mrow>\n        <mrow>\n          <mphantom>\n            <mtext>i1</mtext>\n          </mphantom>\n          <mspace width=\"0.08em\"/>\n          <mphantom>\n            <mtext>i2</mtext>\n          </mphantom>\n        </mrow>\n      </msubsup>\n      <mspace width=\"0.1667em\"/>\n      <msubsup>\n        <mrow>\n          <mi>\ud835\udc54</mi>\n          <mphantom></mphantom>\n        </mrow>\n        <mrow>\n          <mphantom>\n            <mtext>i2</mtext>\n          </mphantom>\n          <mspace width=\"0.08em\"/>\n          <mtext>i1</mtext>\n        </mrow>\n        <mrow>\n          <mtext>i2</mtext>\n          <mspace width=\"0.08em\"/>\n          <mphantom>\n            <mtext>i1</mtext>\n          </mphantom>\n        </mrow>\n      </msubsup>\n    </math></div></div>"
