{\n        font-feature-settings: \"dtls\" 0;\n      }\n      \n      /* Other rules for scriptlevel, displaystyle and math-shift */\n      munder > :nth-child(2),\n      munderover > :nth-child(2) {\n        math-shift: compact\n      }\n      munder[accentunder=\"true\" i] > :not(:first-child),\n      mover[accent=\"true\" i] > :not(:first-child) {\n        math-depth: inherit;\n        math-style: inherit;\n        math-shift: inherit;\n      }\n    </style><math display=\"block\">\n      <mo>\u2212</mo>\n      <mn>1</mn>\n      <mfrac>\n        <mi>\ud835\udc56</mi>\n        <mn>3</mn>\n      </mfrac>\n      <mspace width=\"0.1667em\"/>\n      <mtext>ee</mtext>\n      <mspace width=\"0.1667em\"/>\n      <msubsup>\n        <mrow>\n          <mrow>\n            <mo>[</mo>\n            <msubsup>\n              <mrow>\n                <mi>\ud835\udefe</mi>\n                <mphantom></mphantom>\n              </mrow>\n              <mrow>\n                <mphantom>\n                  <mtext>i0</mtext>\n                </mphantom>\n              </mrow>\n              <mtext>i0</mtext>\n            </msubsup>\n            <mo>]</mo>\n          </mrow>\n          <mphantom></mphantom>\n        </mrow>\n        <mrow>\n          <mtext>i1</mtext>\n          <mspace width=\"0.08em\"/>\n          <mtext>i2</mtext>\n        </mrow>\n        <mrow>\n          <mphantom>\n            <mtext>i1</mtext>\n          </mphantom>\n          <mspace width=\"0.08em\"/>\n          <mphantom>\n            <mtext>i2</mtext>\n          </mphantom>\n        </mrow>\n      </msubsup>\n      <mspace width=\"0.1667em\"/>\n      <msubsup>\n        <mrow>\n          <mi>\ud835\udc54</mi>\n          <mphantom></mphantom>\n        </mrow>\n        <mrow>\n          <mphantom>\n            <mtext>i2</mtext>\n          </mphantom>\n          <mspace width=\"0.08em\"/>\n          <mtext>i1</mtext>\n        </mrow>\n        <mrow>\n          <mtext>i2</mtext>\n          <mspace width=\"0.08em\"/>