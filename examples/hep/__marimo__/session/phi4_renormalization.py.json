          "data": {
            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>Field, mass-squared and coupling renormalization constants</strong></span></span><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">Z\u03c6</span></span><div style=\"white-space: pre-wrap; margin: 0;\">1</div></div><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">Zm</span></span><div style=\"white-space: pre-wrap; margin: 0;\">1<span style=\"color: rgb(205, 205, 0)\">+</span>1/32\u00b7lam\u00b7<span style=\"color: rgb(128, 128, 128)\">(</span>log4pi-gamma_E+1/eps<span style=\"color: rgb(128, 128, 128)\">)</span>/<span style=\"color: rgb(205, 0, 205)\">\ud835\udf0b</span>\u00b2</div></div><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">Zg</span></span><div style=\"white-space: pre-wrap; margin: 0;\">1<span style=\"color: rgb(205, 205, 0)\">+</span>3/32\u00b7lam\u00b7<span style=\"color: rgb(128, 128, 128)\">(</span>log4pi-gamma_E+1/eps<span style=\"color: rgb(128, 128, 128)\">)</span>/<span style=\"color: rgb(205, 0, 205)\">\ud835\udf0b</span>\u00b2</div></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">All UV poles cancel against the generated counterterms. In MS the finite amplitude retains the loop residue times log(4\u03c0)\u2212\u03b3E.</span></span></div>"
          }
