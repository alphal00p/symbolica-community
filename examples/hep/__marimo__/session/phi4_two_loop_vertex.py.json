      "id": "bkHC",
      "code_hash": "0bf6095fc2e58d92b390672a5f526369",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"bare-four-point-uv-reduction\">Bare four-point UV reduction</h2></span><div style=\"white-space: pre-wrap; margin: 0;\">3\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>2,1,1<span style=\"color: rgb(0, 95, 175)\">)</span><span style=\"color: rgb(205, 205, 0)\">+</span>3/4\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>2,2,0<span style=\"color: rgb(0, 95, 175)\">)</span><span style=\"color: rgb(205, 205, 0)\">+</span>3/2\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>3,1,0<span style=\"color: rgb(0, 95, 175)\">)</span></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>Computed native IBP reductions</strong></span></span><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div style=\"white-space: pre-wrap; margin: 0;\">I<span style=\"color: rgb(0, 95, 175)\">(</span>2,1,1<span style=\"color: rgb(0, 95, 175)\">)</span></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><marimo-tex class=\"arithmatex\">||(\\longrightarrow||)</marimo-tex></span></span><div style=\"white-space: pre-wrap; margin: 0;\">1/3\u00b7<span style=\"color: rgb(128, 128, 128)\">(</span>d\u00b7V-3\u00b7V<span style=\"color: rgb(128, 128, 128)\">)</span>/M</div></div><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div style=\"white-space: pre-wrap; margin: 0;\">I<span style=\"color: rgb(0, 95, 175)\">(</span>2,2,0<span style=\"color: rgb(0, 95, 175)\">)</span></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><marimo-tex class=\"arithmatex\">||(\\longrightarrow||)</marimo-tex></span></span><div style=\"white-space: pre-wrap; margin: 0;\">1/4\u00b7<span style=\"color: rgb(128, 128, 128)\">(</span>-4\u00b7d\u00b7T2+4\u00b7T2+d\u00b2\u00b7T2<span style=\"color: rgb(128, 128, 128)\">)</span>/M\u00b2</div></div><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div style=\"white-space: pre-wrap; margin: 0;\">I<span style=\"color: rgb(0, 95, 175)\">(</span>3,1,0<span style=\"color: rgb(0, 95, 175)\">)</span></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><marimo-tex class=\"arithmatex\">||(\\longrightarrow||)</marimo-tex></span></span><div style=\"white-space: pre-wrap; margin: 0;\">1/8\u00b7<span style=\"color: rgb(128, 128, 128)\">(</span>-6\u00b7d\u00b7T2+8\u00b7T2+d\u00b2\u00b7T2<span style=\"color: rgb(128, 128, 128)\">)</span>/M\u00b2</div></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>Bare two-loop UV poles</strong></span></span><div style=\"white-space: pre-wrap; margin: 0;\">-3/4/eps<span style=\"color: rgb(205, 205, 0)\">+</span>9/2\u00b7Lm/eps<span style=\"color: rgb(205, 205, 0)\">-</span>9/2\u00b7L4pi/eps<span style=\"color: rgb(205, 205, 0)\">-</span>9/4/eps\u00b2</div></div>"
