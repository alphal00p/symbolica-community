135)\">)</span><span style=\"color: rgb(135, 95, 175)\">)</span>,k<span style=\"color: rgb(135, 95, 175)\">(</span>mink<span style=\"color: rgb(0, 175, 135)\">(</span>D<span style=\"color: rgb(0, 175, 135)\">)</span><span style=\"color: rgb(135, 95, 175)\">)</span><span style=\"color: rgb(0, 95, 175)\">)</span><span style=\"color: rgb(205, 205, 0)\">-</span>2\u00b7dot<span style=\"color: rgb(0, 95, 175)\">(</span>k<span style=\"color: rgb(135, 95, 175)\">(</span>mink<span style=\"color: rgb(0, 175, 135)\">(</span>D<span style=\"color: rgb(0, 175, 135)\">)</span><span style=\"color: rgb(135, 95, 175)\">)</span>,p<span style=\"color: rgb(135, 95, 175)\">(</span>mink<span style=\"color: rgb(0, 175, 135)\">(</span>D<span style=\"color: rgb(0, 175, 135)\">)</span><span style=\"color: rgb(135, 95, 175)\">)</span><span style=\"color: rgb(0, 95, 175)\">)</span></div></td></tr></tbody></table></section><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>K\u00e4ll\u00e9n polynomial \u03bb(s,a,b)</strong></span></span><div style=\"white-space: pre-wrap; margin: 0;\">-2\u00b7s\u00b7a<span style=\"color: rgb(205, 205, 0)\">-</span>2\u00b7s\u00b7b<span style=\"color: rgb(205, 205, 0)\">-</span>2\u00b7a\u00b7b<span style=\"color: rgb(205, 205, 0)\">+</span>s\u00b2<span style=\"color: rgb(205, 205, 0)\">+</span>a\u00b2<span style=\"color: rgb(205, 205, 0)\">+</span>b\u00b2</div></div>"
