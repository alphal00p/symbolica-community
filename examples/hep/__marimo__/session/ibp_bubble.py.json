)\">(</span>1,1<span style=\"color: rgb(0, 95, 175)\">)</span>+4\u00b7a\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>0,1<span style=\"color: rgb(0, 95, 175)\">)</span>-2\u00b7a\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>1,0<span style=\"color: rgb(0, 95, 175)\">)</span>\n    -2\u00b7b\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>1,0<span style=\"color: rgb(0, 95, 175)\">)</span>+6\u00b7a\u00b2\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>1,1<span style=\"color: rgb(0, 95, 175)\">)</span>\n<span style=\"color: rgb(128, 128, 128)\">)</span>/<span style=\"color: rgb(128, 128, 128)\">(</span>a\u00b7<span style=\"color: rgb(0, 95, 175)\">(</span>-2\u00b7s\u00b7a-2\u00b7s\u00b7b-2\u00b7a\u00b7b+s\u00b2+a\u00b2+b\u00b2<span style=\"color: rgb(0, 95, 175)\">)</span><span style=\"color: rgb(128, 128, 128)\">)</span></div></div><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div style=\"white-space: pre-wrap; margin: 0;\">I<span style=\"color: rgb(0, 95, 175)\">(</span>1,2<span style=\"color: rgb(0, 95, 175)\">)</span></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><marimo-tex class=\"arithmatex\">||(\\longrightarrow||)</marimo-tex></span></span><div style=\"white-space: pre-wrap; margin: 0;\">-1/2\u00b7<span style=\"color: rgb(128, 128, 128)\">(</span>2\u00b7D\u00b7s\u00b7b\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>1,1<span style=\"color: rgb(0, 95, 175)\">)</span>-D\u00b7s\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>0,1<span style=\"color: rgb(0, 95, 175)\">)</span>+2\u00b7D\u00b7a\u00b7b\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>1,1<span style=\"color: rgb(0, 95, 175)\">)</span>+D\u00b7a\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>0,1<span style=\"color: rgb(0, 95, 175)\">)</span>+D\u00b7b\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>0,1<span style=\"color: rgb(0,