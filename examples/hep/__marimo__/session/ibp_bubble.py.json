    {
      "id": "lEQa",
      "code_hash": "3ffd122710af0d7d49f9e20977b490e1",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>Dimensional expansion:</strong> all three <marimo-tex class=\"arithmatex\">||(1/\\epsilon||)</marimo-tex> coefficients cancel.\nExpand at <marimo-tex class=\"arithmatex\">||(D=4-2\\epsilon||)</marimo-tex> <strong>before</strong> setting <marimo-tex class=\"arithmatex\">||(\\epsilon=0||)</marimo-tex>:\nthe <marimo-tex class=\"arithmatex\">||(O(\\epsilon)||)</marimo-tex> reduction coefficients multiply UV poles of the\nindividual master integrals and contribute finite rational terms.</span></span>"
          }
        }
      ],
      "console": []
