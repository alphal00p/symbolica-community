, 95, 175)\">)</span>-2\u00b7b\u00b3\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>1,0<span style=\"color: rgb(0, 95, 175)\">)</span>\n<span style=\"color: rgb(128, 128, 128)\">)</span>/<span style=\"color: rgb(128, 128, 128)\">(</span>a\u00b7b\u00b7<span style=\"color: rgb(0, 95, 175)\">(</span>-2\u00b7s\u00b7a-2\u00b7s\u00b7b-2\u00b7a\u00b7b+s\u00b2+a\u00b2+b\u00b2<span style=\"color: rgb(0, 95, 175)\">)</span>\u00b2<span style=\"color: rgb(128, 128, 128)\">)</span></div></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">The unresolved basis at this search depth is <code>I(1,0), I(0,1), I(1,1)</code>. These are the two tadpoles and the ordinary bubble; <code>residuals</code> does not certify a minimal master basis.</span></span><marimo-ui-element object-id='bkHC-0' random-id='ce657486-a4f4-f3a5-a0f8-b3baa74f4bba'><marimo-table data-initial-value='[]' data-label='null' data-data='&quot;[{&#92;&quot;exact_trace_rows&#92;&quot;:8,&#92;&quot;rows&#92;&quot;:58,&#92;&quot;sectors&#92;&quot;:3,&#92;&quot;seeds&#92;&quot;:30}]&quot;' data-total-rows='1' data-total-columns='4' data-max-columns='50' data-banner-text='&quot;&quot;' data-pagination='false' data-page-size='10' data-show-filters='false' data-show-download='true' data-show-search='true' data-show-column-summaries='false' data-show-data-types='true' data-show-page-size-selector='false' data-show-column-explorer='true' data-show-chart-builder='true' data-row-headers='[]' data-hidden-columns='[]' data-has-stable-row-id='false' data-lazy='false' data-preload='false'></marimo-table></marimo-ui-element></div>"
