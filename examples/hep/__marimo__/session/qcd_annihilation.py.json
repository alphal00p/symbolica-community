      "code_hash": "c503a7077051b1ff05ea88aa0504905b",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h1 id=\"different-flavor-qcd-annihilation\">Different-flavor QCD annihilation</h1>\n<span class=\"paragraph\"><a href=\"/\">Browse all notebooks</a></span>\n<span class=\"paragraph\">Generate <marimo-tex class=\"arithmatex\">||(b\\bar b\\to t\\bar t||)</marimo-tex> through gluon exchange, retaining both\nquark masses. Initial spins and colors are averaged; final spins and colors\nare summed. <code>Particle.color_sum</code> supplies the shared completeness tensor,\nand Idenso contracts the color and Dirac algebra.</span>\n<span class=\"paragraph\">The symbolic <marimo-tex class=\"arithmatex\">||(SU(N_c)||)</marimo-tex> result uses <marimo-tex class=\"arithmatex\">||(T_R=1/2||)</marimo-tex> and agrees with the\n<a href=\"https://feyncalc.github.io/FeynCalcExamples/QCD/Tree/QiQibar-QjQjbar\" rel=\"noopener noreferrer\" target=\"_blank\">FeynCalc reference</a>.\nThe massless <marimo-tex class=\"arithmatex\">||(SU(3)||)</marimo-tex> limit is carried through two-body phase space below.</span></span>"
          }
        }
      ],
      "console": []
    },
