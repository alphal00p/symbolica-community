(135, 95, 175)\">)</span>,p<span style=\"color: rgb(135, 95, 175)\">(</span>mink<span style=\"color: rgb(0, 175, 135)\">(</span>D<span style=\"color: rgb(0, 175, 135)\">)</span><span style=\"color: rgb(135, 95, 175)\">)</span><span style=\"color: rgb(0, 95, 175)\">)</span>\n    <span style=\"color: rgb(205, 205, 0)\">-</span>2\u00b7dot<span style=\"color: rgb(0, 95, 175)\">(</span>k<span style=\"color: rgb(135, 95, 175)\">(</span>mink<span style=\"color: rgb(0, 175, 135)\">(</span>D<span style=\"color: rgb(0, 175, 135)\">)</span><span style=\"color: rgb(135, 95, 175)\">)</span>,q<span style=\"color: rgb(135, 95, 175)\">(</span>mink<span style=\"color: rgb(0, 175, 135)\">(</span>D<span style=\"color: rgb(0, 175, 135)\">)</span><span style=\"color: rgb(135, 95, 175)\">)</span><span style=\"color: rgb(0, 95, 175)\">)</span></div></td></tr></tbody></table></section><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>Exact reduction to <marimo-tex class=\"arithmatex\">||(I(1,0,1)||)</marimo-tex></strong></span></span><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div style=\"white-space: pre-wrap; margin: 0;\">I<span style=\"color: rgb(0, 95, 175)\">(</span>1,1,1<span style=\"color: rgb(0, 95, 175)\">)</span></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><marimo-tex class=\"arithmatex\">||(\\longrightarrow||)</marimo-tex></span></span><div style=\"white-space: pre-wrap; margin: 0;\">-2\u00b7<span style=\"color: rgb(128, 128, 128)\">(</span>-3+D<span style=\"color: rgb(128, 128, 128)\">)</span>\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>1,0,1<span style=\"color: rgb(0, 95, 175)\">)</span>/<span style=\"color: rgb(128, 128, 128)\">(</span>s\u00b7<span style=\"color: rgb(0, 95, 175)\">(</span>-4+D<span style=\"color: rgb(0, 95, 175)\">)</span><span style=\"color: rgb(128, 128, 128)\">)</span></div></div><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div style=\"white-space: pre-wrap; margin: 0;\">I<span style=\"color: rgb(0, 95, 175)\">(</span>2,1,1<span style=\"color: rgb(0, 95, 175)\">)</span></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><marimo-tex class=\"arithmatex\">||(\\longrightarrow||)</marimo-tex></span></span><div style=\"white-space: pre-wrap; margin: 0;\">2\u00b7<span style=\"color: rgb(128, 128, 128)\">(</span>-3+D<span style=\"color: rgb(128, 128, 128)\">)</span>\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>1,0,1<span style=\"color: rgb(0, 95, 175)\">)</span>/s\u00b2</div></div><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div style=\"white-space: pre-wrap; margin: 0;\">I<span style=\"color: rgb(0, 95, 175)\">(</span>1,2,1<span style=\"color: rgb(0, 95, 175)\">)</span></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><marimo-tex class=\"arithmatex\">||(\\longrightarrow||)</marimo-tex></span></span><div style=\"white-space: pre-wrap; margin: 0;\">4\u00b7<span style=\"color: rgb(128, 128, 128)\">(</span>-3+D<span style=\"color: rgb(128, 128, 128)\">)</span>\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>1,0,1<span style=\"color: rgb(0, 95, 175)\">)</span>/<span style=\"color: rgb(128, 128, 128)\">(</span>s\u00b2\u00b7<span style=\"color: rgb(0, 95, 175)\">(</span>-6+D<span style=\"color: rgb(0, 95, 175)\">)</span><span style=\"color: rgb(128, 128, 128)\">)</span></div></div><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div style=\"white-space: pre-wrap; margin: 0;\">I<span style=\"color: rgb(0, 95, 175)\">(</span>1,1,2<span style=\"color: rgb(0, 95, 175)\">)</span></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><marimo-tex class=\"arithmatex\">||(\\longrightarrow||)</marimo-tex></span></span><div style=\"white-space: pre-wrap; margin: 0;\">2\u00b7<span style=\"color: rgb(128, 128, 128)\">(</span>-3+D<span style=\"color: rgb(128, 128, 128)\">)</span>\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>1,0,1<span style=\"color: rgb(0, 95, 175)\">)</span>/s\u00b2</div></div><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div style=\"white-space: pre-wrap; margin: 0;\">I<span style=\"color: rgb(0, 95, 175)\">(</span>2,1,2<span style=\"color: rgb(0, 95, 175)\">)</span></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><marimo-tex class=\"arithmatex\">||(\\longrightarrow||)</marimo-tex></span></span><div style=\"white-space: pre-wrap; margin: 0;\">-2\u00b7<span style=\"color: rgb(128, 128, 128)\">(</span>-120+79\u00b7D-16\u00b7D\u00b2+D\u00b3<span style=\"color: rgb(128, 128, 128)\">)</span>\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>1,0,1<span style=\"color: rgb(0, 95, 175)\">)</span>/<span style=\"color: rgb(128, 128, 128)\">(</span>s\u00b3\u00b7<span style=\"color: rgb(0, 95, 175)\">(</span>-6+D<span style=\"color: rgb(0, 95, 175)\">)</span><span style=\"color: rgb(128, 128, 128)\">)</span></div></div><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div style=\"white-space: pre-wrap; margin: 0;\">I<span style=\"color: rgb(0, 95, 175)\">(</span>2,0,1<span style=\"color: rgb(0, 95, 175)\">)</span></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><marimo-tex class=\"arithmatex\">||(\\longrightarrow||)</marimo-tex></span></span><div style=\"white-space: pre-wrap; margin: 0;\">-<span style=\"color: rgb(128, 128, 128)\">(</span>-3+D<span style=\"color: rgb(128, 128, 128)\">)</span>\u00b7I<span style=\"color: rgb(0, 95, 175)\">(</span>1,0,1<span style=\"color: rgb(0, 95, 175)\">)</span>/s</div></div><marimo-ui-element object-id='vblA-0' random-id='787fd39c-89b6-8cfd-8735-1997144c637b'><marimo-table data-initial-value='[]' data-label='null' data-data='&quot;[{&#92;&quot;exact_trace_rows&#92;&quot;:12,&#92;&quot;rows&#92;&quot;:63,&#92;&quot;sectors&#92;&quot;:2,&#92;&quot;seeds&#92;&quot;:22}]&quot;' data-total-rows='1' data-total-columns='4' data-max-columns='50' data-banner-text='&quot;&quot;' data-pagination='false' data-page-size='10' data-show-filters='false' data-show-download='true' data-show-search='true' data-show-column-summaries='false' data-show-data-types='true' data-show-page-size-selector='false' data-show-column-explorer='true' data-show-chart-builder='true' data-row-headers='[]' data-hidden-columns='[]' data-has-stable-row-id='false' data-lazy='false' data-preload='false'></marimo-table></marimo-ui-element></div>"
