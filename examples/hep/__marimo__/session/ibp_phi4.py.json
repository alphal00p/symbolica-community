            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>Bare two-loop UV poles</strong></span></span><div style=\"white-space: pre-wrap; margin: 0;\">-M/eps<span style=\"color: rgb(205, 205, 0)\">+</span>M\u00b7Lm/eps<span style=\"color: rgb(205, 205, 0)\">-</span>M\u00b7L4pi/eps<span style=\"color: rgb(205, 205, 0)\">-</span>1/2\u00b7M/eps\u00b2<span style=\"color: rgb(205, 205, 0)\">+</span>1/24\u00b7p2/eps</div></div>"
