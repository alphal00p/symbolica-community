      "outputs": [
        {
          "type": "data",
          "data": {
            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"native-ibp-reductions\">Native IBP reductions</h2></span><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">The finite Laporta search used 230 equations from 58 seeds.</span></span><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div style=\"white-space: pre-wrap; margin: 0;\">I<span style=\"color: rgb(0, 95, 175)\">(</span>1,1,1<span style=\"color: rgb(0, 95, 175)\">)</span></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><marimo-tex class=\"arithmatex\">||(\\longrightarrow||)</marimo-tex></span></span><div style=\"white-space: pre-wrap; margin: 0;\">V</div></div><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div style=\"white-space: pre-wrap; margin: 0;\">I<span style=\"color: rgb(0, 95, 175)\">(</span>1,1,2<span style=\"color: rgb(0, 95, 175)\">)</span></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><marimo-tex class=\"arithmatex\">||(\\longrightarrow||)</marimo-tex></span></span><div style=\"white-space: pre-wrap; margin: 0;\">1/3\u00b7<span style=\"color: rgb(128, 128, 128)\">(</span>d\u00b7V-3\u00b7V<span style=\"color: rgb(128, 128, 128)\">)</span>/M</div></div><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div style=\"white-space: pre-wrap; margin: 0;\">I<span style=\"color: rgb(0, 95, 175)\">(</span>1,1,3<span style=\"color: rgb(0, 95, 175)\">)</span></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><marimo-tex class=\"arithmatex\">||(\\longrightarrow||)</marimo-tex></span></span><div style=\"white-space: pre-wrap; margin: 0;\">1/36\u00b7<span style=\"color: rgb(128, 128, 128)\">(</span>-22\u00b7d\u00b7M\u00b7V-12\u00b7d\u00b7T2+48\u00b7M\u00b7V+12\u00b7T2+2\u00b7d\u00b2\u00b7M\u00b7V+3\u00b7d\u00b2\u00b7T2<span style=\"color: rgb(128, 128, 128)\">)</span>/M\u00b3</div></div><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div style=\"white-space: pre-wrap; margin: 0;\">I<span style=\"color: rgb(0, 95, 175)\">(</span>2,1,0<span style=\"color: rgb(0, 95, 175)\">)</span></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><marimo-tex class=\"arithmatex\">||(\\longrightarrow||)</marimo-tex></span></span><div style=\"white-space: pre-wrap; margin: 0;\">1/2\u00b7<span style=\"color: rgb(128, 128, 128)\">(</span>d\u00b7T2-2\u00b7T2<span style=\"color: rgb(128, 128, 128)\">)</span>/M</div></div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>Reduced bare self-energy</strong></span></span><div style=\"white-space: pre-wrap; margin: 0;\">-1/216\u00b7<span style=\"color: rgb(128, 128, 128)\">(</span>4\u00b7d\u00b7M\u00b7p2\u00b7V+54\u00b7d\u00b7M\u00b7T2+48\u00b7d\u00b7p2\u00b7T2-36\u00b7d\u00b7M\u00b2\u00b7V-48\u00b7M\u00b7p2\u00b7V-48\u00b7p2\u00b7T2+4\u00b7d\u00b2\u00b7M\u00b7p2\u00b7V\n    -27\u00b7d\u00b2\u00b7M\u00b7T2-12\u00b7d\u00b2\u00b7p2\u00b7T2\n<span style=\"color: rgb(128, 128, 128)\">)</span>/<span style=\"color: rgb(128, 128, 128)\">(</span>d\u00b7M\u00b2<span style=\"color: rgb(128, 128, 128)\">)</span></div></div>"
