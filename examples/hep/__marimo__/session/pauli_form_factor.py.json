=\"n\">live_children</span> <span class=\"o\">=</span> <span class=\"p\">[</span><span class=\"n\">as_html</span><span class=\"p\">(</span><span class=\"n\">item</span><span class=\"p\">)</span> <span class=\"k\">for</span> <span class=\"n\">item</span> <span class=\"ow\">in</span> <span class=\"n\">items</span><span class=\"p\">]</span>\n<span class=\"w\">                     </span><span class=\"pm\">^^^^^^^^^^^^^</span>\n  File <span class=\"nb\">\"/common/dev/symbolica-community/main/.venv-feynkit/lib/python3.11/site-packages/marimo/_output/formatting.py\"</span>, line <span class=\"m\">314</span>, in <span class=\"n\">as_html</span>\n<span class=\"w\">    </span><span class=\"n\">mimetype</span><span class=\"p\">,</span> <span class=\"n\">data</span> <span class=\"o\">=</span> <span class=\"n\">formatter</span><span class=\"p\">(</span><span class=\"n\">value</span><span class=\"p\">)</span>\n<span class=\"w\">                     </span><span class=\"pm\">^^^^^^^^^^^^^^^^</span>\n  File <span class=\"nb\">\"/common/dev/symbolica-community/main/.venv-feynkit/lib/python3.11/site-packages/marimo/_output/formatters/repr_formatters.py\"</span>, line <span class=\"m\">190</span>, in <span class=\"n\">f_repr</span>\n<span class=\"w\">    </span><span class=\"n\">contents</span> <span class=\"o\">=</span> <span class=\"n\">method</span><span class=\"p\">()</span>\n<span class=\"w\">               </span><span class=\"pm\">^^^^^^^^</span>\n<span class=\"gr\">typst.TypstError</span>: <span class=\"n\">unexpected argument: external-centroid-bias</span>\n</pre></div>\n</span>",
