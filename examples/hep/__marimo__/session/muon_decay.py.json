            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>Mass correction f(r)</strong></span></span><div style=\"white-space: pre-wrap; margin: 0;\">1<span style=\"color: rgb(205, 205, 0)\">-</span>8\u00b7r<span style=\"color: rgb(205, 205, 0)\">-</span>12\u00b7r\u00b2\u00b7<span style=\"color: rgb(205, 0, 205)\">log</span><span style=\"color: rgb(0, 95, 175)\">(</span>r<span style=\"color: rgb(0, 95, 175)\">)</span><span style=\"color: rgb(205, 205, 0)\">+</span>8\u00b7r\u00b3<span style=\"color: rgb(205, 205, 0)\">-</span>r\u2074</div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>Normalized massless Michel spectrum</strong></span></span><div style=\"white-space: pre-wrap; margin: 0;\">6\u00b7xE\u00b2<span style=\"color: rgb(205, 205, 0)\">-</span>4\u00b7xE\u00b3</div><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>Massless width through order M\u00b2/mW\u00b2</strong></span></span><div style=\"white-space: pre-wrap; margin: 0;\">1/320\u00b7GF\u00b2\u00b7M\u2077/<span style=\"color: rgb(128, 128, 128)\">(</span><span style=\"color: rgb(205, 0, 205)\">\ud835\udf0b</span>\u00b3\u00b7MW\u00b2<span style=\"color: rgb(128, 128, 128)\">)</span><span style=\"color: rgb(205, 205, 0)\">+</span>1/192\u00b7GF\u00b2\u00b7M\u2075/<span style=\"color: rgb(205, 0, 205)\">\ud835\udf0b</span>\u00b3</div></div>"
