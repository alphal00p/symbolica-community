    {
      "id": "nWHF",
      "code_hash": "dfc400d5563caa7061a67eed05d12fb9",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"working-with-your-own-ufo\">Working with your own UFO</h2>\n<span class=\"paragraph\">Point <code>UfoLoader.load</code> at the UFO package directory and choose a\n<code>restriction_name</code> matching <code>restrict_&lt;name&gt;.dat</code>; use <code>None</code> to accept the\npackage's default behavior. Keep <code>simplify_model=True</code> for the usual removal\nof zero contributions. Disable <code>wrap_indices_in_lorentz_structures</code> only\nwhen interoperating with code that specifically expects unwrapped UFO\nsyntax.</span>\n<span class=\"paragraph\">For reproducible production workflows, normalize once with the UFO bridge and serialize the resulting <code>Model</code> to JSON; later sessions can load that JSON without the optional Python dependency.</span></span>"
          }
        }
      ],
      "console": []
    }
