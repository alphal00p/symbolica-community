            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"check-normalization-diagnostics\">Check normalization diagnostics</h2>\n<span class=\"paragraph\">These counts describe the normalized model actually handed to Rust. They are useful provenance when comparing model restrictions or diagnosing an unexpected set of interaction rules.</span></span>"
          }
        }
      ],
      "console": []
