    },
    {
      "id": "iXej",
      "code_hash": "a206e7cae834e3ceb3cd029114337bcc",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"check-the-sum\">Check the sum</h2>\n<span class=\"paragraph\">For the selected gluon, ghost, and bottom loops, the transverse pole coefficient\nis <marimo-tex class=\"arithmatex\">||(13G^2p^2/3||)</marimo-tex>. The longitudinal pole cancels. This is a gluon-field counterterm;\nit is not the QCD beta-function coefficient. Keep <marimo-tex class=\"arithmatex\">||(p^2\\ne0||)</marimo-tex>.</span></span>"
          }
        }
      ],
      "console": []
    },
