      "code_hash": "9ca2a819096907e62d49e02906854523",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"generate-the-diagrams\">Generate the diagrams</h2>\n<span class=\"paragraph\">Keep exactly two powers of the QCD coupling and no QED vertices.\nThe current selection keeps the gluon, ghost, and bottom-quark bubbles.\nThe zero-snail filter removes the massless tadpole.</span></span>"
          }
        }
      ],
      "console": []
    },
    {
